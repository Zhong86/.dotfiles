//  https://github.com/m3tozz/FastCat

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file", 
    "source": "/home/Zhong/.config/fastfetch/logo.txt"
  },

  "display": {
    "separator": " "
  }, 

  "modules": [
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐"
    },
    {
      "type": "os",
      "key": " OS",
      "keyColor": "red"
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "red"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "red"
    },
    {
      "type": "de",
      "key": "│ ├",
      "keyColor": "red"
    },
    { 
      "type": "shell",
      "key": "└ └",
      "keyColor": "red"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "showPeCoreCount": true,
      "keyColor": "green",
      "format": "{name} ({cores-online})"
    },
    {
      "type": "gpu",
      "hideIntegrated": true,
      "key": "│ ├󰍛",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "│ ├󰍛",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "│ ├",
      "keyColor": "green"
    },
    {
      "type": "monitor", 
      "key": "└ └",
      "keyColor": "green",
      "format": "{width}x{height} @ {refresh-rate}Hz "
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    {
      "type": "custom",
      "format": "\u001b[90m┌─────────────────────Information────────────────────┐"
    },
        //{
         // "type": "command",
         // "key": "  OS Age ",
         // "keyColor": "magenta",
         // "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        //},
        {
          "type": "uptime",
          "key": "  Uptime ",
          "keyColor": "blue"
        },
        {
          "type": "battery", 
          "temp": true,
          "key": "  Battery ",
          "keyColor": "blue"
        },
        {
          "type": "wallpaper",
          "key": "  Wallpaper ",
          "keyColor": "blue"
        },
        {
          "type": "custom",
          "format": "\u001b[90m└────────────────────────────────────────────────────┘"
        },
          ]
}
